<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UniTracks.Maui.Views.Tabs.StartPage.TripsTab"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converter="clr-namespace:UniTracks.Maui.Views.Converter"
    xmlns:tripModels="clr-namespace:UniTracks.Models.Trip;assembly=UniTracks.Models"
    xmlns:views="clr-namespace:UniTracks.Maui.Views.Controls">

    <ContentView.Resources>
        <ResourceDictionary>
            <converter:DateTimeDifferenceConverter x:Key="DateTimeDifferenceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid BackgroundColor="{StaticResource Surface}" RowDefinitions="Auto,*">

        <!-- Hero header -->
        <Border
            Grid.Row="0"
            Background="{StaticResource HeroGradientBrush}"
            Padding="20,24,20,16"
            StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Label Style="{StaticResource HeroTitle}" Text="Deine Trips" />
                    <Label Style="{StaticResource SubtitleLabel}" Text="Jeder Kilometer zählt." />
                </VerticalStackLayout>

                <!-- The filter lives in the header instead of its own row: a bar of chips would cost
                     a whole line of height even when no filter is set. -->
                <Grid Grid.Column="1" VerticalOptions="Center">
                    <Button
                        x:Name="FilterButton"
                        Clicked="OnFilterClicked"
                        HeightRequest="40"
                        MinimumHeightRequest="0"
                        Padding="16,8"
                        Style="{StaticResource SecondaryButton}"
                        Text="Filter" />
                    <Border
                        x:Name="FilterBadge"
                        BackgroundColor="{StaticResource Accent}"
                        HeightRequest="20"
                        HorizontalOptions="End"
                        IsVisible="False"
                        Margin="0,-6,-6,0"
                        MinimumWidthRequest="20"
                        Padding="6,0"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="FilterBadgeLabel"
                            FontFamily="OpenSansSemibold"
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource OnAccent}"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <RefreshView x:Name="Refresh" Grid.Row="1">
            <CollectionView
                x:Name="TracksCollectionView"
                Background="Transparent"
                RemainingItemsThreshold="3"
                SelectionChanged="TracksCollectionView_SelectionChanged"
                SelectionMode="Single">

                <CollectionView.EmptyView>
                    <Grid Padding="32" VerticalOptions="Center">
                        <VerticalStackLayout
                            x:Name="EmptyNoTrips"
                            Spacing="12">
                            <Border
                                Background="{StaticResource AccentSoft}"
                                HeightRequest="88"
                                HorizontalOptions="Center"
                                Stroke="{StaticResource AccentDim}"
                                StrokeThickness="1"
                                WidthRequest="88">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="44"
                                    Source="run.png"
                                    WidthRequest="44" />
                            </Border>
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource TitleLabel}"
                                Text="Noch keine Trips" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource SubtitleLabel}"
                                Text="Starte deine erste Aufnahme im Record-Tab&#xA;und sammle deine ersten Kilometer." />
                        </VerticalStackLayout>

                        <!-- "Nothing recorded" and "nothing matches the filter" are different
                             situations with different ways out, so they get different texts. -->
                        <VerticalStackLayout
                            x:Name="EmptyFilteredTrips"
                            IsVisible="False"
                            Spacing="12">
                            <Border
                                Background="{StaticResource AccentSoft}"
                                HeightRequest="88"
                                HorizontalOptions="Center"
                                Stroke="{StaticResource AccentDim}"
                                StrokeThickness="1"
                                WidthRequest="88">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="44"
                                    Source="search.png"
                                    WidthRequest="44" />
                            </Border>
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource TitleLabel}"
                                Text="Keine Trips für diese Auswahl" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource SubtitleLabel}"
                                Text="Passe die Filter an oder setze sie zurück,&#xA;um wieder alle Trips zu sehen." />
                            <Button
                                Clicked="OnResetFiltersClicked"
                                HorizontalOptions="Center"
                                Style="{StaticResource SecondaryButton}"
                                Text="Filter zurücksetzen" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.Header>
                    <Grid HeightRequest="8" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="16,4,16,20">
                        <!-- The threshold above needs scrolling, so a screen tall enough to show the
                             whole first block gets an explicit button instead. -->
                        <Button
                            x:Name="LoadMoreButton"
                            Clicked="OnLoadMoreClicked"
                            IsVisible="False"
                            Style="{StaticResource SecondaryButton}"
                            Text="Weitere Trips laden" />
                    </VerticalStackLayout>
                </CollectionView.Footer>

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="12"
                        Orientation="Horizontal"
                        VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="tripModels:Trip">
                        <Grid Padding="16,0">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="{StaticResource CardAlt}"
                                            Invoked="OnRenameInvoked"
                                            Text="Umbenennen" />
                                        <SwipeItem
                                            BackgroundColor="{StaticResource Record}"
                                            Invoked="OnDeleteInvoked"
                                            Text="Löschen" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <views:TripCard
                                    AverageSpeed="{Binding AverageSpeed}"
                                    Distance="{Binding Distance}"
                                    HeartRates="{Binding HeartRates}"
                                    IsCompact="{Binding CompactLayout, Source={x:Reference Root}}"
                                    MaxAltitude="{Binding MaxAltitude}"
                                    MaxSpeed="{Binding MaxSpeed}"
                                    MinAltitude="{Binding MinAltitude}"
                                    MinSpeed="{Binding MinSpeed}"
                                    Name="{Binding Name}"
                                    TripDateTime="{Binding StartTime}"
                                    TripType="{Binding TripType}"
                                    Weather="{Binding Weather}">
                                    <views:TripCard.Duration>
                                        <MultiBinding Converter="{StaticResource DateTimeDifferenceConverter}">
                                            <Binding Mode="OneWay" Path="EndTime" />
                                            <Binding Mode="OneWay" Path="StartTime" />
                                        </MultiBinding>
                                    </views:TripCard.Duration>
                                </views:TripCard>
                            </SwipeView>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="DisplayStates">
                        <VisualState x:Name="Display1">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="ItemsLayout">
                                    <Setter.Value>
                                        <GridItemsLayout
                                            HorizontalItemSpacing="12"
                                            Orientation="Vertical"
                                            Span="1"
                                            VerticalItemSpacing="12" />
                                    </Setter.Value>
                                </Setter>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Display2">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="ItemsLayout">
                                    <Setter.Value>
                                        <GridItemsLayout
                                            HorizontalItemSpacing="12"
                                            Orientation="Vertical"
                                            Span="2"
                                            VerticalItemSpacing="12" />
                                    </Setter.Value>
                                </Setter>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentView>
