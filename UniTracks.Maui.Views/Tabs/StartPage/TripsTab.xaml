<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UniTracks.Maui.Views.Tabs.StartPage.TripsTab"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converter="clr-namespace:UniTracks.Maui.Views.Converter"
    xmlns:tripModels="clr-namespace:UniTracks.Models.Trip;assembly=UniTracks.Models"
    xmlns:views="clr-namespace:UniTracks.Maui.Views.Controls">

    <ContentView.Resources>
        <ResourceDictionary>
            <converter:DateTimeDifferenceConverter x:Key="DateTimeDifferenceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid BackgroundColor="{StaticResource Surface}" RowDefinitions="Auto,*">

        <!-- Hero header -->
        <Border
            Grid.Row="0"
            Background="{StaticResource HeroGradientBrush}"
            Padding="20,24,20,16"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="2">
                <Label Style="{StaticResource HeroTitle}" Text="Deine Trips" />
                <Label Style="{StaticResource SubtitleLabel}" Text="Jeder Kilometer zählt." />
            </VerticalStackLayout>
        </Border>

        <RefreshView x:Name="Refresh" Grid.Row="1">
            <CollectionView
                x:Name="TracksCollectionView"
                Background="Transparent"
                SelectionChanged="TracksCollectionView_SelectionChanged"
                SelectionMode="Single">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="32"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Border
                            Background="{StaticResource AccentSoft}"
                            HeightRequest="88"
                            HorizontalOptions="Center"
                            Stroke="{StaticResource AccentDim}"
                            StrokeThickness="1"
                            WidthRequest="88">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="44"
                                Source="run.png"
                                WidthRequest="44" />
                        </Border>
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource TitleLabel}"
                            Text="Noch keine Trips" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SubtitleLabel}"
                            Text="Starte deine erste Aufnahme im Record-Tab&#xA;und sammle deine ersten Kilometer." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Header>
                    <Grid HeightRequest="8" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <Grid HeightRequest="16" />
                </CollectionView.Footer>

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="12"
                        Orientation="Horizontal"
                        VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="tripModels:Trip">
                        <Grid Padding="16,0">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="{StaticResource CardAlt}"
                                            Invoked="OnRenameInvoked"
                                            Text="Umbenennen" />
                                        <SwipeItem
                                            BackgroundColor="{StaticResource Record}"
                                            Invoked="OnDeleteInvoked"
                                            Text="Löschen" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <views:TripCard
                                    AverageSpeed="{Binding AverageSpeed}"
                                    Distance="{Binding Distance}"
                                    MaxSpeed="{Binding MaxSpeed}"
                                    MinSpeed="{Binding MinSpeed}"
                                    Name="{Binding Name}"
                                    TripDateTime="{Binding StartTime}">
                                    <views:TripCard.Duration>
                                        <MultiBinding Converter="{StaticResource DateTimeDifferenceConverter}">
                                            <Binding Mode="OneWay" Path="EndTime" />
                                            <Binding Mode="OneWay" Path="StartTime" />
                                        </MultiBinding>
                                    </views:TripCard.Duration>
                                </views:TripCard>
                            </SwipeView>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="DisplayStates">
                        <VisualState x:Name="Display1">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="ItemsLayout">
                                    <Setter.Value>
                                        <GridItemsLayout
                                            HorizontalItemSpacing="12"
                                            Orientation="Vertical"
                                            Span="1"
                                            VerticalItemSpacing="12" />
                                    </Setter.Value>
                                </Setter>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Display2">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="ItemsLayout">
                                    <Setter.Value>
                                        <GridItemsLayout
                                            HorizontalItemSpacing="12"
                                            Orientation="Vertical"
                                            Span="2"
                                            VerticalItemSpacing="12" />
                                    </Setter.Value>
                                </Setter>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentView>
