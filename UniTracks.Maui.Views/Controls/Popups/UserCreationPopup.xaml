<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="UniTracks.Maui.Views.Controls.Popups.UserCreationPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:UniTracks.ViewModels.Controls.Popups;assembly=UniTracks.ViewModels"
    x:DataType="vm:UserCreationPopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <toolkit:Popup.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="IsEnabled" Value="True" />
        </Style>
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource CardAlt}" />
            <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="12" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Style" Value="{StaticResource SectionHeader}" />
        </Style>
    </toolkit:Popup.Resources>

    <Border
        Padding="24"
        Style="{StaticResource CardBorder}"
        WidthRequest="420">
        <VerticalStackLayout Spacing="12">

            <Label Style="{StaticResource TitleLabel}" Text="Profil erstellen" />
            <Label
                Style="{StaticResource SubtitleLabel}"
                Text="Lege dein Sportler-Profil an, um Trips aufzuzeichnen." />

            <Label Style="{StaticResource SectionHeader}" Text="NAME" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Placeholder="Dein Name">
                    <Entry.Behaviors>
                        <toolkit:CharactersValidationBehavior
                            CharacterType="Alphanumeric"
                            Flags="ValidateOnValueChanged"
                            InvalidStyle="{StaticResource InvalidEntryStyle}"
                            MinimumCharacterTypeCount="1"
                            ValidStyle="{StaticResource ValidEntryStyle}" />
                    </Entry.Behaviors>
                </Entry>
            </Border>

            <Label Style="{StaticResource SectionHeader}" Text="EMAIL" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry Keyboard="Email" Placeholder="name@example.com" />
            </Border>

            <Label Style="{StaticResource SectionHeader}" Text="PASSWORT" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry IsPassword="True" Placeholder="Passwort" />
            </Border>

            <Label Style="{StaticResource SectionHeader}" Text="PASSWORT BESTÄTIGEN" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry IsPassword="True" Placeholder="Passwort wiederholen" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Style="{StaticResource SectionHeader}" Text="GRÖSSE" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Keyboard="Numeric" Placeholder="cm" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Style="{StaticResource SectionHeader}" Text="GEWICHT" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Keyboard="Numeric" Placeholder="kg" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12"
                Margin="0,8,0,0">
                <Button
                    Command="{Binding CreateUserCommand}"
                    Grid.Column="0"
                    Text="Erstellen" />
                <Button
                    Command="{Binding CancelCommand}"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Text="Standard" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
