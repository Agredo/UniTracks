<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="UniTracks.Maui.Views.Controls.Popups.WhatsNewPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:UniTracks.ViewModels.Controls.Popups;assembly=UniTracks.ViewModels"
    x:DataType="vm:WhatsNewPopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <toolkit:Popup.Resources>
        <Style x:Key="ChangelogBadge" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
            <Setter Property="Stroke" Value="{StaticResource AccentDim}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="8" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChangelogBadgeLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource Accent}" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChangelogTextLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="ChangelogReleaseLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        </Style>
    </toolkit:Popup.Resources>

    <Border
        Padding="24"
        Style="{StaticResource CardBorder}"
        WidthRequest="420">
        <VerticalStackLayout Spacing="14">

            <Label Style="{StaticResource TitleLabel}" Text="Was ist neu?" />
            <Label Style="{StaticResource SubtitleLabel}" Text="{Binding Subtitle}" />

            <ScrollView MaximumHeightRequest="420">
                <VerticalStackLayout Spacing="12">

                    <Label Style="{StaticResource SectionHeader}" Text="{Binding CurrentHeading}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Current.Changes}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChangelogChangeViewModel">
                                <Grid ColumnDefinitions="82,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Style="{StaticResource ChangelogBadge}">
                                        <Label Style="{StaticResource ChangelogBadgeLabel}" Text="{Binding Label}" />
                                    </Border>
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource ChangelogTextLabel}"
                                        Text="{Binding Text}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        IsVisible="{Binding HasEarlier}"
                        Margin="0,10,0,0"
                        Spacing="12">

                        <Label Style="{StaticResource SectionHeader}" Text="VORHERIGE VERSIONEN" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Earlier}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChangelogReleaseViewModel">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Style="{StaticResource ChangelogReleaseLabel}" Text="{Binding Heading}" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Changes}" Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChangelogChangeViewModel">
                                                    <Grid ColumnDefinitions="82,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Style="{StaticResource ChangelogBadge}">
                                                            <Label Style="{StaticResource ChangelogBadgeLabel}" Text="{Binding Label}" />
                                                        </Border>
                                                        <Label
                                                            Grid.Column="1"
                                                            Style="{StaticResource ChangelogTextLabel}"
                                                            Text="{Binding Text}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <Button Command="{Binding CloseCommand}" Text="Alles klar" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
