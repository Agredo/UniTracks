<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="UniTracks.Maui.Views.Controls.Popups.TripEditPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:UniTracks.ViewModels.Controls.Popups;assembly=UniTracks.ViewModels"
    x:DataType="vm:TripEditPopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <toolkit:Popup.Resources>
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource CardAlt}" />
            <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="12" />
                </Setter.Value>
            </Setter>
        </Style>
    </toolkit:Popup.Resources>

    <Border
        x:Name="PopupCard"
        Padding="24"
        Style="{StaticResource ScrollCardBorder}">
        <VerticalStackLayout Spacing="12">

            <Label Style="{StaticResource TitleLabel}" Text="Trip bearbeiten" />
            <Label
                Style="{StaticResource SubtitleLabel}"
                Text="Name, Typ und Notiz nachträglich anpassen. Ein leerer Name behält den automatischen." />

            <Label Style="{StaticResource SectionHeader}" Text="NAME" />
            <Border Style="{StaticResource FieldBorder}">
                <Entry
                    Placeholder="z. B. Runde am See"
                    Text="{Binding Name}" />
            </Border>

            <Label Style="{StaticResource SectionHeader}" Text="TYP" />
            <Border Style="{StaticResource FieldBorder}" Padding="12,4">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        FontSize="14"
                        Text="{Binding SelectedTypeName}"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Padding="14,6"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Accent}"
                        BorderWidth="1"
                        Command="{Binding ChangeTypeCommand}"
                        CornerRadius="15"
                        FontSize="12"
                        Text="Ändern"
                        TextColor="{StaticResource Accent}" />
                </Grid>
            </Border>

            <Label Style="{StaticResource SectionHeader}" Text="NOTIZ" />
            <Border Style="{StaticResource FieldBorder}" Padding="12,8">
                <Editor
                    AutoSize="TextChanges"
                    HeightRequest="80"
                    Placeholder="z. B. mit Hund, nasse Strecke..."
                    Text="{Binding Description}" />
            </Border>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12"
                Margin="0,8,0,0">
                <Button
                    Command="{Binding SaveCommand}"
                    Grid.Column="0"
                    Text="Speichern" />
                <Button
                    Command="{Binding CancelCommand}"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Text="Abbrechen" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
