<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UniTracks.Maui.Views.Controls.TripCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border Style="{StaticResource CardBorder}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

            <!-- Activity icon, tinted by trip type -->
            <Border
                x:Name="IconBadge"
                Grid.Column="0"
                HeightRequest="64"
                Style="{StaticResource AccentChipBorder}"
                VerticalOptions="Start"
                WidthRequest="64">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Image
                    x:Name="TypeIconImage"
                    Aspect="AspectFit"
                    HeightRequest="32"
                    Source="run.png"
                    WidthRequest="32" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="10">

                <!-- Title + type badge + date -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label
                        x:Name="TripNameLabel"
                        Grid.Column="0"
                        FontFamily="OpenSansSemibold"
                        FontSize="17"
                        VerticalTextAlignment="Center" />
                    <Border
                        x:Name="TypeBadge"
                        Grid.Column="1"
                        Padding="8,2"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="TypeBadgeLabel"
                            FontFamily="OpenSansSemibold"
                            FontSize="10" />
                    </Border>
                    <Label
                        x:Name="TripDateLabel"
                        Grid.Column="2"
                        FontSize="11"
                        TextColor="{StaticResource TextMuted}"
                        VerticalTextAlignment="Center" />
                </Grid>

                <!-- Hero distance (+ all stats on one line in compact mode) -->
                <HorizontalStackLayout Spacing="4">
                    <Label
                        x:Name="DistanceValueLabel"
                        FontFamily="OpenSansSemibold"
                        FontSize="30"
                        Text="0"
                        TextColor="{StaticResource Accent}" />
                    <Label
                        x:Name="DistanceUnitLabel"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        Text="km"
                        TextColor="{StaticResource TextMuted}"
                        VerticalOptions="End"
                        VerticalTextAlignment="End" />
                    <Label
                        x:Name="CompactStatsLabel"
                        FontSize="13"
                        IsVisible="False"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="End"
                        VerticalTextAlignment="End" />
                </HorizontalStackLayout>

                <!-- Stat chips -->
                <Grid x:Name="StatsGrid" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="DAUER" />
                            <Label
                                x:Name="DurationValueLabel"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="--:--" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="&#xD8; KM/H" />
                            <Label
                                x:Name="AverageSpeedValueLabel"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="-" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="MAX KM/H" />
                            <Label
                                x:Name="MaxSpeedValueLabel"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="-" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Extras: weather, heart rate, elevation - only when recorded -->
                <HorizontalStackLayout x:Name="ExtrasRow" IsVisible="False" Spacing="14">
                    <HorizontalStackLayout x:Name="WeatherBlock" IsVisible="False" Spacing="4">
                        <Label x:Name="WeatherIconLabel" FontSize="13" VerticalTextAlignment="Center" />
                        <Label
                            x:Name="WeatherTempLabel"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="HeartRateBlock" IsVisible="False" Spacing="4">
                        <Label
                            FontSize="13"
                            Text="&#x2764;"
                            TextColor="{StaticResource Record}"
                            VerticalTextAlignment="Center" />
                        <Label
                            x:Name="HeartRateLabel"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="ElevationBlock" IsVisible="False" Spacing="4">
                        <Label
                            FontSize="13"
                            Text="&#x25B2;"
                            TextColor="{StaticResource TextMuted}"
                            VerticalTextAlignment="Center" />
                        <Label
                            x:Name="ElevationLabel"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
