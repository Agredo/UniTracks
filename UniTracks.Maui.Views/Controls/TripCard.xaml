<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UniTracks.Maui.Views.Controls.TripCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border Style="{StaticResource CardBorder}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

            <!-- Activity icon -->
            <Border
                Grid.Column="0"
                HeightRequest="64"
                Style="{StaticResource AccentChipBorder}"
                VerticalOptions="Start"
                WidthRequest="64">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Image
                    Aspect="AspectFit"
                    HeightRequest="32"
                    Source="run.png"
                    WidthRequest="32" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="10">

                <!-- Title + date -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        x:Name="TripNameLabel"
                        Grid.Column="0"
                        FontFamily="OpenSansSemibold"
                        FontSize="17"
                        VerticalTextAlignment="Center" />
                    <Label
                        x:Name="TripDateLabel"
                        Grid.Column="1"
                        FontSize="11"
                        TextColor="{StaticResource TextMuted}"
                        VerticalTextAlignment="Center" />
                </Grid>

                <!-- Hero distance -->
                <HorizontalStackLayout Spacing="4">
                    <Label
                        x:Name="DistanceValueLabel"
                        FontFamily="OpenSansSemibold"
                        FontSize="30"
                        Text="0"
                        TextColor="{StaticResource Accent}" />
                    <Label
                        x:Name="DistanceUnitLabel"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        Text="km"
                        TextColor="{StaticResource TextMuted}"
                        VerticalOptions="End"
                        VerticalTextAlignment="End" />
                </HorizontalStackLayout>

                <!-- Stat chips -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="DAUER" />
                            <Label
                                x:Name="DurationValueLabel"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="--:--" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="&#xD8; KM/H" />
                            <Label
                                x:Name="AverageSpeedValueLabel"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="-" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="MAX KM/H" />
                            <Label
                                x:Name="MaxSpeedValueLabel"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="-" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
