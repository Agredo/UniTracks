<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniTracks.Maui.Views.Pages.Tabs.UserPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UniTracks.ViewModels.Pages.Tabs;assembly=UniTracks.ViewModels"
    Title="Profil"
    x:DataType="viewModels:UserPagevViewModel">

    <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

        <!-- Profile hero -->
        <Border
            Background="{StaticResource HeroGradientBrush}"
            Padding="24,20"
            Stroke="{StaticResource CardStroke}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="16">
                    <Border
                        Background="{StaticResource AccentSoft}"
                        HeightRequest="72"
                        Stroke="{StaticResource AccentDim}"
                        StrokeThickness="1"
                        WidthRequest="72">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36" />
                        </Border.StrokeShape>
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="36"
                            Source="user.png"
                            WidthRequest="36" />
                    </Border>
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Style="{StaticResource TitleLabel}" Text="Dein Profil" />
                        <Label Style="{StaticResource SubtitleLabel}" Text="{Binding GreetingText}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Quick progress chips -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource AccentChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="LEVEL" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="{Binding LevelText}"
                                TextColor="{StaticResource Accent}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="STREAK" />
                            <HorizontalStackLayout Spacing="4">
                                <Label FontSize="14" Text="🔥" VerticalOptions="Center" />
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    Text="{Binding StreakText}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="GESAMT" />
                            <HorizontalStackLayout Spacing="3">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    Text="{Binding TotalDistanceText}" />
                                <Label
                                    FontSize="11"
                                    Text="km"
                                    TextColor="{StaticResource TextMuted}"
                                    VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- This week, this year and the trip count -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="DIESE WOCHE" />
                            <HorizontalStackLayout Spacing="3">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    Text="{Binding WeekDistanceText}" />
                                <Label
                                    FontSize="11"
                                    Text="km"
                                    TextColor="{StaticResource TextMuted}"
                                    VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="TOUREN" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="{Binding TripsText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="DIESES JAHR" />
                            <HorizontalStackLayout Spacing="3">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    Text="{Binding YearDistanceText}" />
                                <Label
                                    FontSize="11"
                                    Text="km"
                                    TextColor="{StaticResource TextMuted}"
                                    VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Button
                    Command="{Binding OpenProfileCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Profil bearbeiten" />
            </VerticalStackLayout>
        </Border>

        <!-- Profile section -->
        <VerticalStackLayout Spacing="8">
            <Label Style="{StaticResource SectionHeader}" Text="MEIN PROFIL" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label FontFamily="OpenSansSemibold" FontSize="15" Text="Profil bearbeiten" />
                        <Label
                            FontSize="12"
                            Text="Name, E-Mail, Größe und Gewicht"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button
                        Command="{Binding OpenProfileCommand}"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Text="Öffnen"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label FontFamily="OpenSansSemibold" FontSize="15" Text="Statistiken" />
                        <Label
                            FontSize="12"
                            Text="Wochenübersicht, Rekorde und Spiele"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button
                        Command="{Binding OpenStatisticsCommand}"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Text="Öffnen"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Settings section -->
        <VerticalStackLayout Spacing="8">
            <Label Style="{StaticResource SectionHeader}" Text="EINSTELLUNGEN" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label FontFamily="OpenSansSemibold" FontSize="15" Text="Karte, GPS &amp; Daten" />
                        <Label
                            FontSize="12"
                            Text="Kartenstil, Glättung, Datenbank und Standortfreigabe"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button
                        Command="{Binding OpenSettingsCommand}"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Text="Öffnen"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- About section -->
        <VerticalStackLayout Spacing="8">
            <Label Style="{StaticResource SectionHeader}" Text="ÜBER" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label FontFamily="OpenSansSemibold" FontSize="15" Text="Über diese App" />
                        <Label
                            FontSize="12"
                            Text="Agredo Application · Aus Bremen mit Liebe"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button
                        Command="{Binding OpenAboutCommand}"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Text="Öffnen"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Help section -->
        <VerticalStackLayout Spacing="8">
            <Label Style="{StaticResource SectionHeader}" Text="HILFE" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label FontFamily="OpenSansSemibold" FontSize="15" Text="Hilfe &amp; Anleitung" />
                        <Label
                            FontSize="12"
                            Text="Münzen, Spiele und Bedienung erklärt"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button
                        Command="{Binding OpenHelpCommand}"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Text="Öffnen"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Feedback section -->
        <VerticalStackLayout Spacing="8">
            <Label Style="{StaticResource SectionHeader}" Text="FEEDBACK" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label FontFamily="OpenSansSemibold" FontSize="15" Text="Feedback senden" />
                        <Label
                            FontSize="12"
                            Text="Hilf uns, UniTracks besser zu machen · BugBear"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button
                        Command="{Binding OpenFeedbackCommand}"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Text="Öffnen"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
