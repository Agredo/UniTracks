<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniTracks.Maui.Views.Pages.Tabs.RecordTripTabPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UniTracks.ViewModels.Pages.Tabs;assembly=UniTracks.ViewModels"
    xmlns:models="clr-namespace:UniTracks.Models.Trip;assembly=UniTracks.Models"
    Title="Record Trip"
    x:DataType="viewModels:RecordTripTabPageViewModel">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Status chip -->
        <Border
            Grid.Row="0"
            Background="{StaticResource AccentSoft}"
            HorizontalOptions="Center"
            Padding="16,8"
            Stroke="{StaticResource AccentDim}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="8">
                <Ellipse
                    x:Name="StatusDot"
                    Fill="{StaticResource Accent}"
                    HeightRequest="8"
                    VerticalOptions="Center"
                    WidthRequest="8">
                    <Ellipse.Triggers>
                        <DataTrigger
                            Binding="{Binding IsRecording}"
                            TargetType="Ellipse"
                            Value="True">
                            <Setter Property="Fill" Value="{StaticResource Record}" />
                        </DataTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Label
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    FontSize="12"
                    Text="{Binding StatusText}"
                    TextColor="{StaticResource Accent}"
                    VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsRecording}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Record}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </HorizontalStackLayout>
            <Border.Triggers>
                <DataTrigger
                    Binding="{Binding IsRecording}"
                    TargetType="Border"
                    Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource RecordSoft}" />
                    <Setter Property="Stroke" Value="{StaticResource Record}" />
                </DataTrigger>
            </Border.Triggers>
        </Border>

        <!-- Trip type selector -->
        <Grid
            Grid.Row="1"
            Margin="0,20,0,0"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8">

            <!-- Search (Lupe) -->
            <Border
                Grid.Column="0"
                Padding="14,10"
                Stroke="{StaticResource Accent}"
                StrokeThickness="2"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SearchTripTypeCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="search.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="Suchen"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <CollectionView
                Grid.Column="1"
                HeightRequest="56"
                HorizontalScrollBarVisibility="Never"
                ItemsSource="{Binding TripTypes}"
                SelectedItem="{Binding SelectedTripType}"
                SelectionMode="Single"
                VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TripType">
                    <Border
                        Padding="18,10"
                        Stroke="{StaticResource CardStroke}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="{Binding Name}"
                            TextColor="{StaticResource TextSecondary}"
                            VerticalOptions="Center" />
                        <Border.VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
                                        <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource CardAlt}" />
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </Border.VisualStateManager.VisualStateGroups>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>

        <!-- Timer -->
        <Label
            Grid.Row="2"
            HorizontalOptions="Center"
            Style="{StaticResource TimerLabel}"
            Text="{Binding StopWatchTime}"
            VerticalOptions="Center" />

        <!-- Controls -->
        <HorizontalStackLayout
            Grid.Row="3"
            HorizontalOptions="Center"
            Spacing="16"
            VerticalOptions="End">

            <Button
                Command="{Binding StopListeningCommand}"
                Style="{StaticResource DangerButton}"
                Text="Stop"
                VerticalOptions="Center" />

            <Button Command="{Binding StartListeningCommand}" Style="{StaticResource RoundActionButton}">
                <Button.ImageSource>
                    <FileImageSource File="play.png" />
                </Button.ImageSource>
                <Button.Triggers>
                    <DataTrigger
                        Binding="{Binding IsRecording}"
                        TargetType="Button"
                        Value="True">
                        <Setter Property="ImageSource" Value="stop.png" />
                        <Setter Property="BackgroundColor" Value="{StaticResource Record}" />
                        <Setter Property="Shadow">
                            <Setter.Value>
                                <Shadow
                                    Brush="{StaticResource Record}"
                                    Offset="0,6"
                                    Opacity="0.35"
                                    Radius="24" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
