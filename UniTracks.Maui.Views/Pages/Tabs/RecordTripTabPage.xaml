<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniTracks.Maui.Views.Pages.Tabs.RecordTripTabPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UniTracks.ViewModels.Pages.Tabs;assembly=UniTracks.ViewModels"
    Title="Record Trip"
    x:DataType="viewModels:RecordTripTabPageViewModel">

    <ContentPage.Resources>

        <!-- A quick-pick chip is a Border, not a control: the selected look comes from the chip's own
             state, so the row and the "Alle" chip share one markup without cross-bindings. -->
        <Style x:Key="TypeChipBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource CardAlt}" />
            <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="14" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsSelected}"
                    TargetType="Border"
                    Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                    <Setter Property="Stroke" Value="{StaticResource Accent}" />
                    <Setter Property="StrokeThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeChipLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsSelected}"
                    TargetType="Label"
                    Value="True">
                    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeChipIcon" TargetType="Image">
            <Setter Property="HeightRequest" Value="16" />
            <Setter Property="WidthRequest" Value="16" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsSelected}"
                    TargetType="Image"
                    Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The "Alle" chip is not a value of the history: it has no selected state, so it gets the
             same look without the state trigger. -->
        <Style x:Key="AllTypesChipBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource CardAlt}" />
            <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="14" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Status chip -->
        <Border
            Grid.Row="0"
            Background="{StaticResource AccentSoft}"
            HorizontalOptions="Center"
            Padding="16,8"
            Stroke="{StaticResource AccentDim}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="8">
                <Ellipse
                    x:Name="StatusDot"
                    Fill="{StaticResource Accent}"
                    HeightRequest="8"
                    VerticalOptions="Center"
                    WidthRequest="8">
                    <Ellipse.Triggers>
                        <DataTrigger
                            Binding="{Binding IsRecording}"
                            TargetType="Ellipse"
                            Value="True">
                            <Setter Property="Fill" Value="{StaticResource Record}" />
                        </DataTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Label
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    FontSize="12"
                    Text="{Binding StatusText}"
                    TextColor="{StaticResource Accent}"
                    VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsRecording}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Record}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </HorizontalStackLayout>
            <Border.Triggers>
                <DataTrigger
                    Binding="{Binding IsRecording}"
                    TargetType="Border"
                    Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource RecordSoft}" />
                    <Setter Property="Stroke" Value="{StaticResource Record}" />
                </DataTrigger>
            </Border.Triggers>
        </Border>

        <!-- Recording context: what the trip will be tagged with. The active type stays visible
             the whole time so it cannot be forgotten; future attributes (shoes, heart rate, ...)
             extend this area alongside the type. -->
        <VerticalStackLayout
            Grid.Row="1"
            Margin="0,20,0,0"
            Spacing="12">

            <!-- Active activity: prominent and tappable -->
            <Border
                Background="{StaticResource AccentSoft}"
                Padding="16,12"
                Stroke="{StaticResource Accent}"
                StrokeThickness="1.5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SearchTripTypeCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="AKTIVITÄT"
                            TextColor="{StaticResource TextSecondary}" />
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="22"
                            Text="{Binding SelectedTripTypeName}"
                            TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="Ändern"
                        TextColor="{StaticResource Accent}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Quick pick: the recently picked types as chips, wrapping so neither a long name nor a
                 fourth chip is cut off at the screen edge. "Alle" opens the full list behind a popup. -->
            <VerticalStackLayout IsVisible="{Binding IsTripTypeSelectionVisible}" Spacing="8">
                <Label Style="{StaticResource SectionHeader}" Text="ZULETZT VERWENDET" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <FlexLayout
                        Grid.Column="0"
                        AlignItems="Center"
                        BindableLayout.ItemsSource="{Binding FavoriteTripTypes}"
                        Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:RecordTripTypeChip">
                                <Border Style="{StaticResource TypeChipBorder}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectTripTypeCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Image Source="{Binding Icon}" Style="{StaticResource TypeChipIcon}" />
                                        <Label
                                            Style="{StaticResource TypeChipLabel}"
                                            Text="{Binding Label}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- All types (search popup) -->
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource AllTypesChipBorder}"
                        VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SearchTripTypeCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Image
                                HeightRequest="16"
                                Source="search.png"
                                VerticalOptions="Center"
                                WidthRequest="16" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                Text="Alle"
                                TextColor="{StaticResource TextSecondary}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Timer -->
        <Label
            Grid.Row="2"
            HorizontalOptions="Center"
            Style="{StaticResource TimerLabel}"
            Text="{Binding StopWatchTime}"
            VerticalOptions="Center" />

        <!-- Controls: one dominant central action (start / pause / resume) with halo and caption,
             stop as the small secondary action beside it -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,Auto,*"
            VerticalOptions="End">

            <!-- Stop: circular icon button, only active while a trip is open -->
            <VerticalStackLayout
                Grid.Column="0"
                HorizontalOptions="Center"
                Spacing="6"
                VerticalOptions="Center">
                <Button
                    BackgroundColor="{StaticResource RecordSoft}"
                    BorderColor="{StaticResource Record}"
                    BorderWidth="1.5"
                    Command="{Binding StopListeningCommand}"
                    CornerRadius="30"
                    HeightRequest="60"
                    IsEnabled="{Binding CanStop}"
                    MinimumHeightRequest="0"
                    MinimumWidthRequest="0"
                    Padding="0"
                    WidthRequest="60">
                    <Button.ImageSource>
                        <FileImageSource File="stop.png" />
                    </Button.ImageSource>
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding CanStop}"
                            TargetType="Button"
                            Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Label
                    FontAttributes="Bold"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    Text="Stop"
                    TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <!-- Primary action with state-colored halo -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="8"
                VerticalOptions="Center">
                <Border
                    Background="Transparent"
                    HeightRequest="104"
                    Padding="8"
                    Stroke="{StaticResource AccentDim}"
                    StrokeThickness="2"
                    WidthRequest="104">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="52" />
                    </Border.StrokeShape>
                    <Button Command="{Binding StartListeningCommand}" Style="{StaticResource RoundActionButton}">
                        <Button.ImageSource>
                            <FileImageSource File="play.png" />
                        </Button.ImageSource>
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsRecording}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="ImageSource" Value="pause.png" />
                                <Setter Property="BackgroundColor" Value="{StaticResource Record}" />
                                <Setter Property="Shadow">
                                    <Setter.Value>
                                        <Shadow
                                            Brush="{StaticResource Record}"
                                            Offset="0,6"
                                            Opacity="0.35"
                                            Radius="24" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger
                                Binding="{Binding IsPaused}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Warning}" />
                                <Setter Property="Shadow">
                                    <Setter.Value>
                                        <Shadow
                                            Brush="{StaticResource Warning}"
                                            Offset="0,6"
                                            Opacity="0.35"
                                            Radius="24" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Border.Triggers>
                        <DataTrigger
                            Binding="{Binding IsRecording}"
                            TargetType="Border"
                            Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Record}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsPaused}"
                            TargetType="Border"
                            Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Warning}" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Start"
                    TextColor="{StaticResource Accent}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsRecording}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="Text" Value="Pause" />
                            <Setter Property="TextColor" Value="{StaticResource Record}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsPaused}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="Text" Value="Weiter" />
                            <Setter Property="TextColor" Value="{StaticResource Warning}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
