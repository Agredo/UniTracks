<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniTracks.Maui.Views.Pages.TripChartsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:charts="clr-namespace:UniTracks.Maui.Views.Controls.Charts;assembly=UniTracks.Maui.Views"
    xmlns:vm="clr-namespace:UniTracks.ViewModels.Pages;assembly=UniTracks.ViewModels"
    Title="Analyse"
    x:DataType="vm:TripChartsPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Style="{StaticResource TitleLabel}" Text="{Binding TripName}" />
                <Label Style="{StaticResource SubtitleLabel}" Text="{Binding DateText}" />
            </VerticalStackLayout>

            <!-- All stats -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource SectionHeader}" Text="STATISTIKEN" />
                <!-- RowDefinitions is required: MAUI clamps Grid.Row to the last defined row,
                     so without it the second row of chips would be drawn on top of the first. -->
                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="8">
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource AccentChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="DISTANZ" />
                            <HorizontalStackLayout Spacing="3">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    Text="{Binding DistanceText}"
                                    TextColor="{StaticResource Accent}" />
                                <Label
                                    FontSize="11"
                                    Text="{Binding DistanceUnit}"
                                    TextColor="{StaticResource TextMuted}"
                                    VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="BEWEGUNG" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="{Binding MovingTimeText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="{Binding PaceLabel}" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="{Binding PaceText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Grid.Row="0" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="HÖHENMETER" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                Text="{Binding ElevationGainText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="GESAMT" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="{Binding DurationText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="PAUSE" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="{Binding StoppedTimeText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="HÖHENBEREICH" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                Text="{Binding AltitudeText}"
                                VerticalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Grid.Row="1" Style="{StaticResource ChipBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatLabel}" Text="MAX. GPS" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="{Binding MaxSpeedText}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Speed chart -->
            <VerticalStackLayout IsVisible="{Binding HasSpeedProfile}" Spacing="8">
                <Label Style="{StaticResource SectionHeader}" Text="GESCHWINDIGKEIT" />
                <Border Padding="14,14,10,10" Style="{StaticResource CardBorder}">
                    <charts:AxisLineChartView
                        HeightRequest="220"
                        Values="{Binding SpeedProfile}"
                        XLabels="{Binding TimeAxisLabels}"
                        YFormat="0"
                        YUnit="km/h" />
                </Border>
            </VerticalStackLayout>

            <!-- Altitude chart -->
            <VerticalStackLayout IsVisible="{Binding HasAltitudeProfile}" Spacing="8">
                <Label Style="{StaticResource SectionHeader}" Text="HÖHENPROFIL" />
                <Border Padding="14,14,10,10" Style="{StaticResource CardBorder}">
                    <charts:AxisLineChartView
                        HeightRequest="200"
                        FillColor="#336B7A6D"
                        LineColor="{StaticResource TextMuted}"
                        Values="{Binding AltitudeProfile}"
                        XLabels="{Binding TimeAxisLabels}"
                        YFormat="0"
                        YUnit="m" />
                </Border>
            </VerticalStackLayout>

            <!-- Pace chart -->
            <VerticalStackLayout IsVisible="{Binding HasPaceProfile}" Spacing="8">
                <Label Style="{StaticResource SectionHeader}" Text="{Binding PaceChartTitle}" />
                <Border Padding="14,14,10,10" Style="{StaticResource CardBorder}">
                    <charts:AxisLineChartView
                        HeightRequest="200"
                        FillColor="#334D9FE7"
                        LineColor="#4D9FE7"
                        Values="{Binding PaceProfile}"
                        XLabels="{Binding TimeAxisLabels}"
                        InvertY="True"
                        IsPaceScale="True"
                        YUnit="{Binding PaceAxisUnit}" />
                </Border>
            </VerticalStackLayout>

            <!-- Best efforts -->
            <VerticalStackLayout IsVisible="{Binding HasBestEfforts}" Spacing="8">
                <Label Style="{StaticResource SectionHeader}" Text="BESTZEITEN" />
                <Border Padding="14" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Style="{StaticResource StatLabel}" Text="STRECKE" />
                            <Label
                                Grid.Column="1"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource StatLabel}"
                                Text="ZEIT" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource StatLabel}"
                                Text="Ø" />
                        </Grid>
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding BestEfforts}"
                            Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BestEffortRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="13"
                                            Text="{Binding DistanceText}"
                                            TextColor="{StaticResource TextSecondary}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="13"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding TimeText}"
                                            TextColor="{StaticResource TextPrimary}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="13"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding RateText}"
                                            TextColor="{StaticResource TextMuted}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Label
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    Text="Schnellste zusammenhängende Strecke dieses Trips, ohne Standzeit."
                    TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
